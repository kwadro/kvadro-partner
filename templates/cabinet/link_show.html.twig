{% extends 'cabinet/layout.html.twig' %}

{% block title %}{{ link.name }} — {{ 'brand'|trans }}{% endblock %}

{% block cabinet_content %}
<header class="content-header">
    <p class="back-link"><a href="{{ path('app_cabinet_links') }}">{{ 'cabinet.link.back'|trans }}</a></p>
    <h1>{{ link.name }}</h1>
    <p class="mono">{{ link.url }}</p>
</header>

<section class="content-section">
    <div class="stat-row">
        <div class="stat">
            <p class="stat-label">{{ 'cabinet.link.clicks'|trans }}</p>
            <p class="stat-value">{{ link.clicks }}</p>
        </div>
        <div class="stat">
            <p class="stat-label">{{ 'cabinet.link.unique_visitors'|trans }}</p>
            <p class="stat-value">{{ link.unique_visitors }}</p>
        </div>
        <div class="stat">
            <p class="stat-label">{{ 'cabinet.link.orders'|trans }}</p>
            <p class="stat-value">{{ link.orders }}</p>
        </div>
        <div class="stat">
            <p class="stat-label">{{ 'cabinet.link.total_reward'|trans }}</p>
            <p class="stat-value">{{ link.reward }} {{ 'cabinet.account.currency'|trans }}</p>
        </div>
    </div>

    <h2>{{ 'cabinet.link.activity'|trans }}</h2>

    <form class="activity-filter" method="get" action="{{ path('app_cabinet_link_show', { id: link.id }) }}">
        <div class="activity-filter-grid">
            <div class="activity-filter-field">
                <label for="filter-date">{{ 'cabinet.link.date'|trans }}</label>
                <input type="date" id="filter-date" name="date" value="{{ filters.date }}">
            </div>
            <div class="activity-filter-field">
                <label for="filter-ip">{{ 'cabinet.link.ip_address'|trans }}</label>
                <input type="text" id="filter-ip" name="ip" value="{{ filters.ip }}" placeholder="127.0.0.1">
            </div>
            <div class="activity-filter-field">
                <label for="filter-visitor-id">{{ 'cabinet.link.visitor_id'|trans }}</label>
                <input type="text" id="filter-visitor-id" name="visitor_id" value="{{ filters.visitor_id }}" placeholder="visitor_id">
            </div>
            <div class="activity-filter-actions">
                <button type="submit" class="btn btn-primary btn-compact">{{ 'cabinet.link.filter_apply'|trans }}</button>
                <a class="btn btn-secondary btn-compact" href="{{ path('app_cabinet_link_show', { id: link.id }) }}">{{ 'cabinet.link.filter_reset'|trans }}</a>
            </div>
        </div>
    </form>

    <table class="data-table">
        <thead>
            <tr>
                <th>{{ 'cabinet.link.date'|trans }}</th>
                <th>{{ 'cabinet.link.ip_address'|trans }}</th>
                <th>{{ 'cabinet.link.visitor_id'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for view in views.items %}
                <tr>
                    <td>{{ view.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td class="mono">{{ view.ipAddress ?: '—' }}</td>
                    <td class="mono">{{ view.visitorId ?: '—' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">{{ 'cabinet.link.no_activity'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if views.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">
            {% if views.page > 1 %}
                <a class="pagination-link" href="{{ path('app_cabinet_link_show', filters|merge({ id: link.id, page: views.page - 1 })) }}">
                    {{ 'cabinet.link.prev'|trans }}
                </a>
            {% endif %}

            <span class="pagination-status">
                {{ 'cabinet.link.page_status'|trans({ '%page%': views.page, '%pages%': views.pages, '%total%': views.total }) }}
            </span>

            {% if views.page < views.pages %}
                <a class="pagination-link" href="{{ path('app_cabinet_link_show', filters|merge({ id: link.id, page: views.page + 1 })) }}">
                    {{ 'cabinet.link.next'|trans }}
                </a>
            {% endif %}
        </nav>
    {% elseif views.total > 0 %}
        <p class="pagination-status-alone">
            {{ 'cabinet.link.page_status'|trans({ '%page%': views.page, '%pages%': views.pages, '%total%': views.total }) }}
        </p>
    {% endif %}

    <h2>{{ 'cabinet.link.purchases'|trans }}</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>{{ 'cabinet.link.order'|trans }}</th>
                <th>{{ 'cabinet.link.date'|trans }}</th>
                <th>{{ 'cabinet.link.order_amount'|trans }}</th>
                <th>{{ 'cabinet.link.reward'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for purchase in link.purchases %}
                <tr>
                    <td>{{ purchase.order }}</td>
                    <td>{{ purchase.date }}</td>
                    <td>{{ purchase.amount }} {{ 'cabinet.account.currency'|trans }}</td>
                    <td>{{ purchase.reward }} {{ 'cabinet.account.currency'|trans }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">{{ 'cabinet.link.no_purchases'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
