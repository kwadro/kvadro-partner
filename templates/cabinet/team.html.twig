{% extends 'cabinet/layout.html.twig' %}

{% block title %}{{ 'cabinet.team.title'|trans }}{% endblock %}

{% block cabinet_content %}
<header class="content-header">
    <h1>{{ 'cabinet.team.heading'|trans }}</h1>
    <p>{{ 'cabinet.team.lead'|trans }}</p>
</header>

<section class="content-section">
    <div class="stat-row">
        <div class="stat">
            <p class="stat-label">{{ 'cabinet.team.name'|trans }}</p>
            <p class="stat-value">{{ team.name }}</p>
        </div>
        <div class="stat">
            <p class="stat-label">{{ 'cabinet.team.members_count'|trans }}</p>
            <p class="stat-value">{{ team.membersCount }}</p>
        </div>
        <div class="stat">
            <p class="stat-label">{{ 'cabinet.team.created_at'|trans }}</p>
            <p class="stat-value">{{ team.createdAt }}</p>
        </div>
    </div>

    {% if invitedBy %}
        <p class="team-invited-by">
            {{ 'cabinet.team.invited_by'|trans({ '%name%': invitedBy.fullName, '%email%': invitedBy.email }) }}
        </p>
    {% endif %}
</section>

<section class="content-section">
    <h2>{{ 'cabinet.team.members_heading'|trans }}</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>{{ 'cabinet.team.member_name'|trans }}</th>
                <th>{{ 'cabinet.team.member_email'|trans }}</th>
                <th>{{ 'cabinet.team.member_phone'|trans }}</th>
                <th>{{ 'cabinet.team.member_invite'|trans }}</th>
                <th>{{ 'cabinet.team.member_joined'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for member in members %}
                <tr>
                    <td>{{ member.fullName }}</td>
                    <td>{{ member.email }}</td>
                    <td>{{ member.phone ?: '—' }}</td>
                    <td>{{ member.inviteTitle ?: '—' }}</td>
                    <td>{{ member.joinedAt }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">{{ 'cabinet.team.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
