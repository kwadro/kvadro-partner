{% extends 'cabinet/layout.html.twig' %}

{% block title %}{{ 'cabinet.invites.title'|trans }}{% endblock %}

{% block cabinet_content %}
<header class="content-header">
    <h1>{{ 'cabinet.invites.heading'|trans }}</h1>
    <p>{{ 'cabinet.invites.lead'|trans }}</p>
</header>

<section class="content-section">
    <h2>{{ 'cabinet.invites.form.heading'|trans }}</h2>

    {% include 'cabinet/_invite_form.html.twig' with {
        form: form,
        previewBaseUrl: previewBaseUrl,
        submitLabel: 'cabinet.invites.form.save',
        exceptId: 0,
        showBack: false,
    } %}
</section>

<section class="content-section">
    <h2>{{ 'cabinet.invites.list_heading'|trans }}</h2>

    <table class="data-table">
        <thead>
            <tr>
                <th>{{ 'cabinet.invites.title_col'|trans }}</th>
                <th>{{ 'cabinet.invites.key'|trans }}</th>
                <th>{{ 'cabinet.invites.url'|trans }}</th>
                <th>{{ 'cabinet.invites.registrations'|trans }}</th>
                <th>{{ 'cabinet.invites.created_at'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for link in links %}
                <tr>
                    <td>{{ link.title }}</td>
                    <td>{{ link.linkKey }}</td>
                    <td class="url-cell">{{ link.url }}</td>
                    <td>{{ link.registrations }}</td>
                    <td>{{ link.createdAt }}</td>
                    <td class="row-actions">
                        {% if link.canEdit %}
                            <a href="{{ path('app_cabinet_invite_edit', { id: link.id }) }}" class="btn-link-action">{{ 'cabinet.invites.edit'|trans }}</a>
                        {% endif %}
                        {% if link.canDelete %}
                            <form method="post" action="{{ path('app_cabinet_invite_delete', { id: link.id }) }}" onsubmit="return confirm('{{ 'cabinet.invites.delete_confirm'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_invite_' ~ link.id) }}">
                                <button type="submit" class="btn-link-danger">{{ 'cabinet.invites.delete'|trans }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">{{ 'cabinet.invites.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
