{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}
{% block body_class %}page-auth{% endblock %}

{% block body %}
<div class="auth-shell">
    <div class="auth-panel">
        <p class="brand"><a href="{{ path('app_home') }}">{{ 'brand'|trans }}</a></p>
        <h1>{{ 'login.heading'|trans }}</h1>
        <p class="auth-lead">{{ 'login.lead'|trans }}</p>

        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message|trans }}</div>
        {% endfor %}

        {% if error %}
            <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" class="auth-form">
            <label for="email">{{ 'login.email'|trans }}</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus autocomplete="username">

            <label for="password">{{ 'login.password'|trans }}</label>
            <input type="password" id="password" name="password" required autocomplete="current-password">

            <label class="checkbox-row">
                <input type="checkbox" name="_remember_me">
                <span>{{ 'login.remember_me'|trans }}</span>
            </label>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn-primary">{{ 'login.submit'|trans }}</button>
        </form>

        <p class="auth-footer">{{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'login.create_one'|trans }}</a></p>
        <p class="auth-footer"><a class="btn btn-secondary" href="{{ path('app_home') }}">{{ 'nav.back_home'|trans }}</a></p>
    </div>
</div>
{% endblock %}
